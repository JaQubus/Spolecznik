# Skopiuj do .env.local i uzupełnij. .env.local nie trafia do repo.

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publiczny: „Publishable key” (nowe projekty) albo „anon” (starsze) — działa każda z tych nazw
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Tylko dla pipeline'u Pythona (Settings → Database → Connection string)
SUPABASE_DB_URL=

# LLM (Groq, console.groq.com → API Keys)
GROQ_API_KEY=

# API BDL GUS — darmowy X-ClientId podnosi limity
BDL_CLIENT_ID=

# E-mail (Resend)
RESEND_API_KEY=
