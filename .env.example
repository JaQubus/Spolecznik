# Skopiuj do .env.local i uzupełnij. .env.local nie trafia do repo.

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Klucz anon (stary) albo publishable (nowy panel Supabase) — wystarczy jeden z nich.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Tylko dla pipeline'u Pythona (Settings → Database → Connection string)
SUPABASE_DB_URL=

# LLM (Groq, console.groq.com → API Keys)
GROQ_API_KEY=

# Raport gminy (#104): sekret dla scripts/raporty-gmin.mjs (POST /api/raporty-gmin). Dowolny długi losowy ciąg.
GMINA_REPORTS_SECRET=

# API BDL GUS — darmowy X-ClientId podnosi limity
BDL_CLIENT_ID=

# E-mail (Resend) — powiadomienia dla autorów, którzy podali adres (#65). Bez klucza nic nie wysyłamy (demo).
RESEND_API_KEY=
# Nadawca z domeny zweryfikowanej w Resend, np. Społecznik <powiadomienia@twoja-domena.pl>
EMAIL_FROM=
# Adres strony do linków w e-mailach, np. https://spolecznik.example.pl (bez niego mail mówi, gdzie wpisać kod)
SITE_URL=

# Logowanie testowe (Zasobnik wiedzy, panel). Lokalnie działa bez ustawień; na serwerze tylko z obiema zmiennymi.
TEST_LOGIN=
TEST_LOGIN_SECRET=
# Ekspert, jako który działa konto testowe „ekspert” (ref_id z search_index, kind = 'ekspert'). Puste = pierwszy alfabetycznie.
TEST_EXPERT_ID=

# Linki do modułów, których jeszcze nie ma — włącz (=1), gdy moduł będzie gotowy
NEXT_PUBLIC_FLAG_WNIOSEK_UW=
